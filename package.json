{
  "name": "sonar-print-studio",
  "version": "1.0.0",
  "description": "برنامج تجهيز وتنظيم وطباعة صور السونار والتقارير الطبية",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pack-asar.js",
    "pack": "node scripts/pack-asar.js",
