{
  "name": "printify",
  "version": "1.0.0",
  "description": "Printify - برنامج تجهيز وتنظيم وطباعة صور السونار والتقارير الطبية",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pack-asar.js",
    "build:vite": "vite build",
    "build:win": "vite build && electron-builder --win --x64",
    "build:mac": "vite build && electron-builder --mac",
    "build:all": "vite build && electron-builder --win --mac",
    "pack": "node scripts/pack-asar.js",
    "preview": "vite preview",
    "electron": "electron .",
    "keygen": "node scripts/generate-license.js",
    "app": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\""
  },
  "build": {
    "appId": "com.elsakka.printify",
    "productName": "Printify",
    "copyright": "Copyright © 2026 Printify",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Printify"
    }
  },
  "keywords": [
    "ultrasound",
    "sonar",
    "medical-printing",
    "electron"
  ],
  "author": "Printify",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
